# ==============================================================================
# Multi-Agent AI Workflow Automation Platform — Environment Configuration
# ==============================================================================

# Application Configuration
APP_NAME="Multi-Agent AI Workflow Platform"
APP_ENV="development" # development | test | production
API_HOST="0.0.0.0"
API_PORT=8000
LOG_LEVEL="INFO"

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# LLM Configuration
# LLM_PROVIDER: "openai" | "azure" | "ollama" | "mock"
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY="your-api-key-here"
# Optional base URL for OpenAI-compatible providers (e.g. Ollama http://localhost:11434/v1, vLLM, LMStudio, etc.)
LLM_BASE_URL=""

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/workflow_db"

# Docker Compose PostgreSQL Settings
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="workflow_db"
POSTGRES_PORT=5432
