# ==============================================================================
# Multi-Agent AI Workflow Automation Platform — Environment Configuration
# ==============================================================================

# Application Configuration
APP_NAME="Multi-Agent AI Workflow Platform"
APP_ENV="development" # development | test | production
API_HOST="0.0.0.0"
API_PORT=8000
LOG_LEVEL="INFO"

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# LLM Configuration
# LLM_PROVIDER: "openai" | "azure" | "ollama" | "mock"
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY="your-api-key-here"
# Optional base URL for OpenAI-compatible providers (e.g. Ollama http://localhost:11434/v1, vLLM, LMStudio, etc.)
LLM_BASE_URL=""

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/workflow_db"

# Docker Compose PostgreSQL Settings
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="workflow_db"
POSTGRES_PORT=5432

# Document Ingestion & FAISS Vector Settings (Milestone 3)
DOCUMENT_STORAGE_PATH="./data/documents"
FAISS_INDEX_PATH="./data/faiss"
# EMBEDDING_PROVIDER: "mock" | "local" | "openai"
EMBEDDING_PROVIDER="mock"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384
CHUNK_SIZE=1000
MAX_DOCUMENT_SIZE_MB=25

# Validation & Guardrails Settings (Milestone 5)
VALIDATION_ENABLED=true
MAX_VALIDATION_ATTEMPTS=2
VALIDATION_SCORE_THRESHOLD=0.8

# Human-in-the-Loop & Approval Settings (Milestone 6)
APPROVAL_ENABLED=true
MAX_APPROVAL_REVISIONS=3

# Production Hardening & Operational Timeouts (Milestone 8)
ENABLE_DOCS=true
LLM_TIMEOUT=60.0
WORKFLOW_TIMEOUT_SECONDS=120.0
DB_POOL_TIMEOUT=30.0
CHECKPOINTER_POOL_TIMEOUT=10.0
